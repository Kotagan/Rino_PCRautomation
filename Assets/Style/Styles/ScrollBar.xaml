<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="AppleScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Rectangle Fill="#00FFFFFF" Height="{TemplateBinding FrameworkElement.Height}" Width="{TemplateBinding FrameworkElement.Width}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="AppleVerticalScrollBarThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid Background="#00FFFFFF">
            <Border Name="ThumbVisual" Background="{DynamicResource BasePrimaryBrush}" CornerRadius="1.5" HorizontalAlignment="Right" Margin="0,2,1,2" Opacity="0.75" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True" Width="3" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ThumbVisual" Value="{DynamicResource BasePrimaryBrush}" Property="Border.Background" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Duration="0:0:0.18" Storyboard.TargetName="ThumbVisual" Storyboard.TargetProperty="Width" To="5">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Duration="0:0:0.18" Storyboard.TargetName="ThumbVisual" Storyboard.TargetProperty="Opacity" To="1.0">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Duration="0:0:0.25" Storyboard.TargetName="ThumbVisual" Storyboard.TargetProperty="Width" To="3">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Duration="0:0:0.25" Storyboard.TargetName="ThumbVisual" Storyboard.TargetProperty="Opacity" To="0.75">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="Thumb.IsDragging" Value="True">
              <Setter TargetName="ThumbVisual" Property="Width" Value="5" />
              <Setter TargetName="ThumbVisual" Property="UIElement.Opacity" Value="1.0" />
              <Setter TargetName="ThumbVisual" Value="{DynamicResource MouseDownBrush}" Property="Border.Background" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="AppleHorizontalScrollBarThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid Background="#00FFFFFF">
            <Border Name="ThumbVisual" Background="{DynamicResource BasePrimaryBrush}" CornerRadius="1.5" Height="3" Margin="2,0,2,1" Opacity="0.75" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True" VerticalAlignment="Bottom" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ThumbVisual" Value="{DynamicResource BasePrimaryBrush}" Property="Border.Background" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Duration="0:0:0.18" Storyboard.TargetName="ThumbVisual" Storyboard.TargetProperty="Height" To="5">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Duration="0:0:0.18" Storyboard.TargetName="ThumbVisual" Storyboard.TargetProperty="Opacity" To="1.0">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Duration="0:0:0.25" Storyboard.TargetName="ThumbVisual" Storyboard.TargetProperty="Height" To="3">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Duration="0:0:0.25" Storyboard.TargetName="ThumbVisual" Storyboard.TargetProperty="Opacity" To="0.75">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="Thumb.IsDragging" Value="True">
              <Setter TargetName="ThumbVisual" Property="Height" Value="5" />
              <Setter TargetName="ThumbVisual" Property="UIElement.Opacity" Value="1.0" />
              <Setter TargetName="ThumbVisual" Value="{DynamicResource MouseDownBrush}" Property="Border.Background" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Style.Triggers>
      <Trigger Property="ScrollBar.Orientation" Value="Vertical">
        <Setter Property="Width" Value="5" />
        <Setter Property="MinWidth" Value="5" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Grid Name="Bg" Background="#00FFFFFF" SnapsToDevicePixels="True">
                <Track Name="PART_Track" IsDirectionReversed="True">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource AppleScrollBarPageButtonStyle}" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Name="Thumb" Style="{StaticResource AppleVerticalScrollBarThumbStyle}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource AppleScrollBarPageButtonStyle}" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Thumb" Property="Visibility" Value="Collapsed" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
        <Setter Property="Height" Value="5" />
        <Setter Property="MinHeight" Value="5" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Grid Name="Bg" Background="#00FFFFFF" SnapsToDevicePixels="True">
                <Track Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource AppleScrollBarPageButtonStyle}" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Name="Thumb" Style="{StaticResource AppleHorizontalScrollBarThumbStyle}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource AppleScrollBarPageButtonStyle}" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Thumb" Property="Visibility" Value="Collapsed" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="AppleScrollBarStyle" BasedOn="{StaticResource {x:Type ScrollBar}}" TargetType="{x:Type ScrollBar}" />
  <Style x:Key="ScrollBarDefault" BasedOn="{StaticResource {x:Type ScrollBar}}" TargetType="{x:Type ScrollBar}" />
  <Style x:Key="ScrollBarBaseStyle" BasedOn="{StaticResource {x:Type ScrollBar}}" TargetType="{x:Type ScrollBar}" />
</ResourceDictionary>
