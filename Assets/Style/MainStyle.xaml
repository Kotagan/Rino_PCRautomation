    <!--  Apple Modern Growl / Toast Notification Card Style  -->
    <Style TargetType="hc:Growl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinHeight" Value="58" />
        <Setter Property="Width" Value="340" />
        <Setter Property="MaxWidth" Value="340" />
        <Setter Property="Margin" Value="12,8,12,6" />
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:Growl">
                    <Grid x:Name="PART_GridMain" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="GrowlScaleTransform" ScaleX="0.85" ScaleY="0.85" />
                                <TranslateTransform x:Name="GrowlTranslateTransform" X="0" Y="-20" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!-- Apple Elevated Capsule Card (Click anywhere to dismiss) -->
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            Cursor="Hand"
                            SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="22"
                                    Color="#000000"
                                    Direction="270"
                                    Opacity="0.18"
                                    ShadowDepth="4"
                                    RenderingBias="Quality" />
                            </Border.Effect>
                            <Grid Margin="14,12,12,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Icon Badge with Circle Container -->
                                <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,10,0">
                                    <Border
                                        Width="36"
                                        Height="36"
                                        CornerRadius="18"
                                        Background="{TemplateBinding hc:Growl.IconBrush}"
                                        Opacity="0.14" />
                                    <Path
                                        Data="{TemplateBinding hc:Growl.Icon}"
                                        Fill="{TemplateBinding hc:Growl.IconBrush}"
                                        Stretch="Uniform"
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center" />
                                </Grid>

                                <!-- Message & Timestamp -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{TemplateBinding hc:Growl.Message}"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        FontSize="13.5"
                                        FontWeight="Medium"
                                        TextWrapping="Wrap"
                                        LineHeight="18" />
                                    <TextBlock
                                        Text="{Binding Path=Time, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        FontSize="11.5"
                                        Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Apple Circular Close Button -->
                                <Button
                                    x:Name="PART_ButtonClose"
                                    Grid.Column="2"
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Margin="4,0,0,0"
                                    Cursor="Hand"
                                    Style="{StaticResource DialogIconButtonStyle}">
                                    <Path
                                        Data="M 0 0 L 8 8 M 8 0 L 0 8"
                                        Stroke="{DynamicResource ControlIconBrush}"
                                        StrokeThickness="1.6"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round"
                                        Width="8"
                                        Height="8"
                                        Stretch="Uniform"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Button>

                                <!-- Action Buttons for Growl.Ask -->
                                <UniformGrid
                                    x:Name="PART_PanelMore"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Columns="2"
                                    Height="28"
                                    Margin="0,8,0,0"
                                    Visibility="Collapsed"
                                    IsEnabled="False">
                                    <Button
                                        x:Name="PART_ButtonCancel"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource DialogSecondaryButtonStyle}"
                                        Content="{Binding Path=CancelStr, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Button
                                        x:Name="PART_ButtonOk"
                                        Margin="4,0,0,0"
                                        Style="{StaticResource DialogPrimaryButtonStyle}"
                                        Content="{Binding Path=ConfirmStr, RelativeSource={RelativeSource TemplatedParent}}" />
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Apple Spring Entrance -->
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="PART_GridMain"
                                        Storyboard.TargetProperty="Opacity"
                                        From="0.0"
                                        To="1.0"
                                        Duration="0:0:0.26">
                                        <DoubleAnimation.EasingFunction>
                                            <QuarticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation
                                        Storyboard.TargetName="GrowlScaleTransform"
                                        Storyboard.TargetProperty="ScaleX"
                                        From="0.82"
                                        To="1.0"
                                        Duration="0:0:0.36">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase Amplitude="0.28" EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation
                                        Storyboard.TargetName="GrowlScaleTransform"
                                        Storyboard.TargetProperty="ScaleY"
                                        From="0.82"
                                        To="1.0"
                                        Duration="0:0:0.36">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase Amplitude="0.28" EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation
                                        Storyboard.TargetName="GrowlTranslateTransform"
                                        Storyboard.TargetProperty="Y"
                                        From="-24"
                                        To="0"
                                        Duration="0:0:0.32">
                                        <DoubleAnimation.EasingFunction>
                                            <QuarticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  End: VerticalMenuStyle  -->
</ResourceDictionary>
