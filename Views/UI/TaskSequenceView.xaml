<UserControl
    d:DataContext="{d:DesignInstance ui:TaskSequenceView,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d"
    x:Class="MFAWPF.Views.UI.TaskSequenceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:calcBinding="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MFAWPF.Views.UserControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:MFAWPF.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MFAWPF.Helper"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:MFAWPF.Views.UI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SequenceActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SequencePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SequenceSurfaceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="SequenceSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SequenceItemCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Margin" Value="0,0,10,8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="0" Y="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BasePrimaryBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="CardHoverEnter">
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    To="4.0"
                                    Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="CardHoverEnter" />
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    To="0.0"
                                    Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SecundaryBackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:CardControl
            Background="{DynamicResource ControlSurfaceBrush}"
            BorderThickness="0"
            CornerRadius="10"
            Grid.Row="0"
            Margin="20,10,20,10">
            <controls:CardControl.Icon>
                <Path
                    Data="{StaticResource DocumentGeometry}"
                    Fill="{DynamicResource ControlIconBrush}"
                    Height="24"
                    Margin="8"
                    Stretch="Uniform"
                    Width="24" />
            </controls:CardControl.Icon>
            <controls:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Grid.Row="0"
                        Text="{lex:Loc TaskSequence}" />
                    <TextBlock
                        FontSize="13.5"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Grid.Row="1"
                        Margin="0,2,0,0"
                        Text="{lex:Loc TaskSequenceDescription}"
                        TextWrapping="Wrap" />
                </Grid>
            </controls:CardControl.Header>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Command="{Binding ViewModel.ApplyPresetCommand}"
                    Content="{lex:Loc ApplyPreset}"
                    Style="{StaticResource SequencePrimaryButtonStyle}"
                    MinWidth="120" />
            </StackPanel>
        </controls:CardControl>

        <Grid Grid.Row="1" Margin="20,0,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Margin="0,0,10,0" Style="{StaticResource SequenceSurfaceCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="{DynamicResource RegionBrush}"
                            CornerRadius="8"
                            Height="34"
                            Margin="0,0,10,0"
                            Width="34">
                            <Path
                                Data="{StaticResource ConfigGeometry}"
                                Fill="{DynamicResource ControlIconBrush}"
                                Height="16"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                                Width="16" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource SequenceSectionTitleStyle}"
                            Text="{lex:Loc Presets}" />
                    </Grid>

                    <hc:ComboBox
                        extensions:ComboBoxExtensions.DisableNavigationOnLostFocus="True"
                        FontSize="13.5"
                        Grid.Row="1"
                        MinHeight="36"
                        ItemsSource="{Binding ViewModel.Presets}"
                        Margin="0,16,0,12"
                        SelectedItem="{Binding ViewModel.SelectedPreset, Mode=TwoWay}"
                        hc:TitleElement.Title="{lex:Loc PresetName}"
                        hc:TitleElement.TitlePlacement="Top">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="13.5"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Click="DeletePresetButton_Click"
                                        CommandParameter="{Binding}"
                                        Content="×"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Grid.Column="1"
                                        Height="24"
                                        Margin="8,0,0,0"
                                        Padding="0"
                                        Style="{StaticResource textBoxButton}"
                                        ToolTip="{lex:Loc DeletePreset}"
                                        Width="24" />
                                </Grid>
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>

                    <StackPanel Grid.Row="2">
                        <Button
                            Command="{Binding ViewModel.SaveCurrentPresetCommand}"
                            Content="{lex:Loc SavePreset}"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource SequenceActionButtonStyle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Click="NewPresetButton_Click"
                                Content="{lex:Loc NewPreset}"
                                Style="{StaticResource SequenceActionButtonStyle}" />
                            <Button
                                Click="RenamePresetButton_Click"
                                Content="{lex:Loc RenamePreset}"
                                Grid.Column="2"
                                Style="{StaticResource SequenceActionButtonStyle}" />
                        </Grid>
                    </StackPanel>

                    <Button
                        Command="{Binding ViewModel.DeleteCurrentPresetCommand}"
                        Content="{lex:Loc DeletePreset}"
                        Grid.Row="4"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource SequenceActionButtonStyle}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SequenceSurfaceCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource SequenceSectionTitleStyle}"
                                Text="{lex:Loc TaskListHeader}" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Margin="0,3,0,0"
                                Text="{lex:Loc TaskSequenceDescription}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <Button
                                Command="{Binding ViewModel.NumberAllCommand}"
                                Content="{lex:Loc NumberAll}"
                                Margin="0,0,8,0"
                                MinWidth="86"
                                Style="{StaticResource SequenceActionButtonStyle}" />
                            <Button
                                Command="{Binding ViewModel.ClearAllCommand}"
                                Content="{lex:Loc ClearAllOrders}"
                                MinWidth="86"
                                Style="{StaticResource SequenceActionButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Background="{DynamicResource SecundaryBackgroundColor}"
                        CornerRadius="8"
                        Grid.Row="1"
                        Margin="0,16,0,0"
                        Padding="24"
                        VerticalAlignment="Center"
                        Visibility="{calcBinding:Binding '!ViewModel.HasTasks'}">
                        <TextBlock
                            FontSize="14"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            HorizontalAlignment="Center"
                            Text="{lex:Loc NoTasksAvailable}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                    </Border>

                    <ScrollViewer
                        Focusable="False"
                        Grid.Row="1"
                        Margin="0,16,0,0"
                        PanningMode="VerticalOnly"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{calcBinding:Binding 'ViewModel.HasTasks'}">
                        <ItemsControl ItemsSource="{Binding ViewModel.SequenceItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SequenceItemCardBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Background="{DynamicResource BasePrimaryBrush}"
                                                CornerRadius="8"
                                                Height="36"
                                                Margin="0,0,14,0"
                                                MinWidth="36"
                                                Padding="8,0"
                                                VerticalAlignment="Center"
                                                Visibility="{calcBinding:Binding IsAssigned}">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="#FFFFFF"
                                                    HorizontalAlignment="Center"
                                                    Text="{Binding OrderIndex}"
                                                    VerticalAlignment="Center" />
                                            </Border>

                                            <Border
                                                BorderBrush="{DynamicResource SecondaryTextBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="8"
                                                Height="36"
                                                Margin="0,0,14,0"
                                                VerticalAlignment="Center"
                                                Visibility="{calcBinding:Binding '!IsAssigned'}"
                                                Width="36">
                                                <TextBlock
                                                    FontSize="13"
                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                    HorizontalAlignment="Center"
                                                    Text="—"
                                                    VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock
                                                FontSize="14.5"
                                                FontWeight="Medium"
                                                Foreground="{DynamicResource PrimaryTextBrush}"
                                                Grid.Column="1"
                                                Margin="0,0,12,0"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Name}"
                                                VerticalAlignment="Center" />

                                            <StackPanel
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                                <TextBox
                                                    FontSize="13.5"
                                                    FontWeight="Medium"
                                                    Height="34"
                                                    InputMethod.IsInputMethodEnabled="False"
                                                    KeyDown="OnOrderTextBoxKeyDown"
                                                    Margin="0,0,8,0"
                                                    MaxLength="3"
                                                    PreviewTextInput="OnOrderTextBoxPreviewTextInput"
                                                    Text="{Binding InputOrderText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                    TextAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Width="54" />
                                                <Button
                                                    Command="{Binding ViewModel.AssignNextCommand, RelativeSource={RelativeSource AncestorType=ui:TaskSequenceView}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{lex:Loc AssignNext}"
                                                    Margin="0,0,8,0"
                                                    MinWidth="94"
                                                    Style="{StaticResource SequenceActionButtonStyle}" />
                                                <Button
                                                    Command="{Binding ViewModel.ClearOrderCommand, RelativeSource={RelativeSource AncestorType=ui:TaskSequenceView}}"
                                                    CommandParameter="{Binding}"
                                                    Content="×"
                                                    FontSize="16"
                                                    Height="34"
                                                    Padding="0"
                                                    Style="{StaticResource SequenceActionButtonStyle}"
                                                    ToolTip="{lex:Loc ClearOrder}"
                                                    Width="34" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
