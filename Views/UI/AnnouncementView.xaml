<controls:CustomWindow
    Height="540"
    Icon="{x:Static helper:IconHelper.ICON}"
    Title="{Binding ViewModel.AnnouncementTitle, Mode=OneWay}"
    Width="640"
    WindowStartupLocation="CenterScreen"
    d:DataContext="{d:DesignInstance local:AnnouncementView,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d"
    x:Class="MFAWPF.Views.UI.AnnouncementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="clr-namespace:MFAWPF.Views.UserControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MFAWPF.Helper"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:MFAWPF.Views.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mdXaml="https://github.com/whistyun/MdXaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Background="{DynamicResource SecundaryBackgroundColor}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="54" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border
                Background="{DynamicResource MainContentBackgroundBrush}"
                CornerRadius="10 10 0 0"
                x:Name="TitleBar">
                <Grid Height="36">
                    <TextBlock
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        HorizontalAlignment="Center"
                        Text="{Binding ViewModel.AnnouncementTitle, Mode=OneWay}"
                        VerticalAlignment="Center" />
                    <Button
                        Click="CloseButton_Click"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Height="22"
                        HorizontalAlignment="Right"
                        Margin="0,4,6,0"
                        Padding="0"
                        Style="{StaticResource DialogIconButtonStyle}"
                        VerticalAlignment="Top"
                        Width="22"
                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                        x:Name="CloseButton" />
                </Grid>
            </Border>

            <!-- Version Header Banner (Row 1) -->
            <Border
                Grid.Row="1"
                Background="{DynamicResource MainContentBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="16,10,16,4"
                Padding="12,8"
                Visibility="{Binding ViewModel.VersionBannerVisibility, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path
                        Data="{StaticResource GithubGeometry}"
                        Fill="{DynamicResource PrimaryBrush}"
                        Height="18"
                        Width="18"
                        Stretch="Uniform"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center" />
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Text="{Binding ViewModel.VersionText, Mode=OneWay}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Markdown Content (Row 2) -->
            <Border
                Grid.Row="2"
                Background="{DynamicResource MainContentBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="16,6,16,6">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Margin="10,8">
                    <mdXaml:MarkdownScrollViewer
                        Background="Transparent"
                        ClickAction="SafetyOpenBrowser"
                        Focusable="True"
                        Markdown="{Binding ViewModel.AnnouncementInfo, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                        PreviewMouseWheel="HandlePreviewMouseWheel">
                        <mdXaml:MarkdownScrollViewer.MarkdownStyle>
                            <StaticResource ResourceKey="MdXamlStyle" />
                        </mdXaml:MarkdownScrollViewer.MarkdownStyle>
                        <mdXaml:MarkdownScrollViewer.Plugins>
                            <StaticResource ResourceKey="MdXamlPlugin" />
                        </mdXaml:MarkdownScrollViewer.Plugins>
                    </mdXaml:MarkdownScrollViewer>
                </ScrollViewer>
            </Border>

            <!-- Bottom Buttons (Row 3) -->
            <StackPanel
                Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Button
                    Click="AcknowledgeButton_Click"
                    Content="{Binding ViewModel.ConfirmButtonText, Mode=OneWay}"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    MinWidth="130"
                    Height="32"
                    Margin="8,0" />
                <Button
                    Click="CloseButton_Click"
                    Content="稍后重启"
                    Visibility="{Binding ViewModel.RestartButtonVisibility, Mode=OneWay}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    MinWidth="100"
                    Height="32"
                    Margin="8,0" />
            </StackPanel>
        </Grid>
    </Border>
</controls:CustomWindow>