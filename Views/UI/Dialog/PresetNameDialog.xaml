<controls:CustomWindow
    Height="170"
    Width="330"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d"
    x:Class="MFAWPF.Views.UI.Dialog.PresetNameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="clr-namespace:MFAWPF.Views.UserControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Background="{DynamicResource SecundaryBackgroundColor}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border
                Background="{DynamicResource MainContentBackgroundBrush}"
                CornerRadius="10 10 0 0"
                x:Name="TitleBar">
                <Grid Height="34">
                    <TextBlock
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        HorizontalAlignment="Center"
                        x:Name="TitleTextBlock"
                        VerticalAlignment="Center" />
                    <Button
                        Click="CloseButton_Click"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Height="22"
                        HorizontalAlignment="Right"
                        Margin="0,4,6,0"
                        Padding="0"
                        Style="{StaticResource DialogIconButtonStyle}"
                        VerticalAlignment="Top"
                        Width="22"
                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                        x:Name="CloseButton" />
                </Grid>
            </Border>

            <!-- Input Box -->
            <Grid Grid.Row="1" Margin="20,10,20,0">
                <TextBox
                    FontSize="13.5"
                    Height="30"
                    KeyDown="PresetNameTextBox_KeyDown"
                    Loaded="PresetNameTextBox_Loaded"
                    Padding="8,0"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    x:Name="PresetNameTextBox" />
            </Grid>

            <!-- Buttons -->
            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Center"
                Margin="0,0,0,10"
                Orientation="Horizontal">
                <Button
                    Click="ConfirmButton_Click"
                    Content="{lex:Loc Confirm}"
                    Margin="0,0,12,0"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    MinWidth="72"
                    Height="28" />
                <Button
                    Click="CancelButton_Click"
                    Content="{lex:Loc ButtonCancel}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    MinWidth="72"
                    Height="28" />
            </StackPanel>
        </Grid>
    </Border>
</controls:CustomWindow>
