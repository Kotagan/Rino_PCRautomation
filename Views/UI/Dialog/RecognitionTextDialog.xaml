<controls1:CustomWindow
    Height="200"
    IsResizable="True"
    Title="{lex:Loc TextRecognizerTitle}"
    Width="400"
    x:Class="MFAWPF.Views.UI.Dialog.RecognitionTextDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="clr-namespace:MFAWPF.Views.UserControl"
    xmlns:controls1="clr-namespace:MFAWPF.Views.UserControl"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:MFAWPF.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Background="{DynamicResource WhiteColor}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="10"
        MouseDown="Canvas_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <Border
                Background="{DynamicResource MainContentBackgroundBrush}"
                ClipToBounds="False"
                CornerRadius="10 10 0 0"
                x:Name="TitleBar">
                <Grid Height="34">
                    <TextBlock
                        FontSize="17"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        HorizontalAlignment="Center"
                        IsHitTestVisible="False"
                        Margin="0,0,0,0"
                        Text="{lex:Loc TextRecognizerTitle}"
                        VerticalAlignment="Center"
                        x:Name="TitleText" />
                    <Button
                        Click="Close"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Height="22"
                        HorizontalAlignment="Right"
                        Margin="0,4,4,0"
                        Padding="0"
                        Style="{StaticResource DialogIconButtonStyle}"
                        VerticalAlignment="Top"
                        Width="22"
                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                        x:Name="CloseButton" />
                </Grid>
            </Border>
            <hc:LoadingCircle
                Grid.Row="1"
                Height="50"
                Margin="10,5,5,0"
                Width="50"
                x:Name="LoadingCircle" />
            <Viewbox
                Grid.Row="1"
                HorizontalAlignment="Center"
                Visibility="Collapsed"
                x:Name="ImageArea">
                <Grid>
                    <Grid>
                        <Image
                            Grid.Column="0"
                            Grid.Row="0"
                            MaxHeight="720"
                            MaxWidth="1280"
                            Stretch="Uniform"
                            x:Name="image" />
                        <Canvas
                            Background="Transparent"
                            Grid.Column="0"
                            Grid.Row="0"
                            MouseMove="Canvas_MouseMove"
                            MouseUp="Canvas_MouseUp"
                            Panel.ZIndex="1"
                            x:Name="SelectionCanvas" />

                    </Grid>
                    <TextBlock
                        Background="Transparent"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="White"
                        HorizontalAlignment="Left"
                        IsHitTestVisible="False"
                        Margin="10,10,0,0"
                        Panel.ZIndex="2"
                        VerticalAlignment="Top"
                        x:Name="MousePositionText">
                        <TextBlock.Effect>
                            <DropShadowEffect
                                BlurRadius="0"
                                Color="Black"
                                Opacity="1"
                                ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Viewbox>
            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Center"
                Margin="0,10,0,0"
                Orientation="Horizontal">
                <Button
                    Click="SaveButton_Click"
                    Content="{lex:Loc ButtonSave}"
                    Margin="10,0,0,10"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Width="90"
                    x:Name="SaveButton" />
                <Button
                    Click="Close"
                    Content="{lex:Loc ButtonCancel}"
                    Margin="20,0,10,10"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Width="90"
                    x:Name="CancelButton" />
            </StackPanel>
        </Grid>
    </Border>
</controls1:CustomWindow>
