<UserControl
    d:DataContext="{d:DesignInstance local:TaskQueueView,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d"
    x:Class="MFAWPF.Views.UI.TaskQueueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:calcBinding="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MFAWPF.Views.UserControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MFAWPF.Helper"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:MFAWPF.Views.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:MFAWPF.Styles.Properties"
    xmlns:settings="clr-namespace:MFAWPF.Views.UserControl.Settings"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ContextMenu x:Key="TaskMenu">
            <MenuItem Click="Delete" Header="{lex:Loc Delete}" />
        </ContextMenu>

        <Style x:Key="TaskQueueCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="checkBoxBorder"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="4"
                                Height="21"
                                Width="21"
                                HorizontalAlignment="Center"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                                <Grid>
                                    <Path
                                        x:Name="checkMark"
                                        Data="M1.5,5.5 L4.5,8.5 L10.5,2.5"
                                        Stroke="#FFFFFF"
                                        StrokeThickness="2"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="10"
                                        Height="8"
                                        Stretch="Uniform"
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        x:Name="sequenceNumberBadge"
                                        Text="{Binding SequenceOrder}"
                                        Foreground="#FFFFFF"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed" />
                                    <Rectangle
                                        x:Name="indeterminateMark"
                                        Fill="#FFFFFF"
                                        Height="8"
                                        Width="8"
                                        RadiusX="1"
                                        RadiusY="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter
                                x:Name="contentPresenter"
                                Grid.Column="1"
                                Focusable="False"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                RecognizesAccessKey="True"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="true">
                                <Setter Property="Padding" Value="4,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource BasePrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Opacity" TargetName="templateRoot" Value="0.5" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding Path=IsSequenceBadgeVisible}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource BasePrimaryBrush}" />
                                <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource BasePrimaryBrush}" />
                                <Setter Property="Visibility" TargetName="checkMark" Value="Visible" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Path=IsSequenceBadgeVisible}" Value="True">
                                <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource BasePrimaryBrush}" />
                                <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource BasePrimaryBrush}" />
                                <Setter Property="Visibility" TargetName="checkMark" Value="Collapsed" />
                                <Setter Property="Visibility" TargetName="sequenceNumberBadge" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource BasePrimaryBrush}" />
                                <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource BasePrimaryBrush}" />
                                <Setter Property="Visibility" TargetName="indeterminateMark" Value="Visible" />
                                <Setter Property="Visibility" TargetName="checkMark" Value="Collapsed" />
                                <Setter Property="Visibility" TargetName="sequenceNumberBadge" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid
        Background="{DynamicResource SecundaryBackgroundColor}"
        ClipToBounds="False"
        Grid.Row="1"
        Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="260" MaxWidth="450" Width="2.5*" />
            <ColumnDefinition MinWidth="220" Width="2.2*" />
            <ColumnDefinition MinWidth="280" Width="3*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="20,0,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="0"
                Margin="0,2,5,2"
                MinWidth="150"
                VerticalAlignment="Center">

                <TextBlock
                    FontSize="14.5"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    HorizontalAlignment="Left"
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    Text="{lex:Loc TaskList}" />

                <StackPanel
                    HorizontalAlignment="Right"
                    Margin="2,2,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <Button
                        Click="SelectAll"
                        Foreground="{DynamicResource ControlIconBrush}"
                        Height="15"
                        IsEnabled="{Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                        Margin="7,0,0,0"
                        Padding="0"
                        Style="{StaticResource textBoxButton}"
                        ToolTip="{lex:Loc SelectAll}"
                        Width="15"
                        hc:IconElement.Geometry="{StaticResource SelectAllGeometry}" />
                    <Button
                        Click="SelectNone"
                        Foreground="{DynamicResource ControlIconBrush}"
                        Height="15"
                        IsEnabled="{Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                        Margin="7,0,0,0"
                        Padding="0"
                        Style="{StaticResource textBoxButton}"
                        ToolTip="{lex:Loc DeselectAll}"
                        Width="15"
                        hc:IconElement.Geometry="{StaticResource SelectNoneGeometry}" />
                    <Button
                        Click="Edit"
                        Foreground="{DynamicResource ControlIconBrush}"
                        Height="15"
                        IsEnabled="{Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                        Margin="7,0,0,0"
                        Padding="0"
                        Style="{StaticResource textBoxButton}"
                        ToolTip="{lex:Loc EditTask}"
                        Visibility="{calcBinding:Binding 'EnableEdit',
                                                         Source={x:Static helper:Instances.RootViewModel}}"
                        Width="15"
                        hc:IconElement.Geometry="{StaticResource EditGeometry}"
                        x:Name="EditButton" />
                    <Button
                        Click="Edit"
                        Foreground="{DynamicResource ControlIconBrush}"
                        Height="15"
                        IsEnabled="{Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                        Margin="7,0,0,0"
                        Padding="0"
                        Style="{StaticResource textBoxButton}"
                        ToolTip="{lex:Loc TaskSettings}"
                        Visibility="Collapsed"
                        Width="15"
                        hc:IconElement.Geometry="{StaticResource SettingsRegular}" />


                </StackPanel>
            </Grid>

            <ListBox
                AllowDrop="True"
                Background="Transparent"
                BorderThickness="0"
                dd:DragDrop.DropHandler="{Binding ViewModel.DropHandler}"
                dd:DragDrop.IsDragSource="{Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                dd:DragDrop.IsDropTarget="{Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                Grid.Row="1"
                ItemContainerStyle="{StaticResource CustomListBoxItemStyle}"
                ItemsSource="{Binding ViewModel.TaskItemViewModels}"
                Margin="0,5,0,0"
                MinHeight="220"
                Padding="2,3,2,0"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.PanningMode="VerticalOnly"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling"
                x:Name="TaskList">
                <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="ListGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="45" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Click="OnTaskCheckBoxClick"
                                    Content="{Binding Name}"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    IsChecked="{Binding IsCheckedWithNull}"
                                    IsHitTestVisible="{Binding Path=Idle, Source={x:Static helper:Instances.RootViewModel}}"
                                    MouseRightButtonUp="ToggleCheckBoxNullOnRightClick"
                                    Style="{StaticResource TaskQueueCheckBoxStyle}"
                                    ToolTip="{lex:Loc TooltipDragLabel}"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center">
                                    <CheckBox.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="{Binding Name}"
                                                DataContext="{Binding Path=DataContext, 
                                                RelativeSource={RelativeSource AncestorType=CheckBox}}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                VerticalAlignment="Center"
                                                Width="{calcBinding:Binding 'ActualWidth - 78',
                                                                            RelativeSource={RelativeSource Mode=FindAncestor,
                                                                                                           AncestorType={x:Type ListBoxItem}}}">
                                                <TextBlock.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="删除" Click="Delete" />
                                                    </ContextMenu>
                                                </TextBlock.ContextMenu>
                                            </TextBlock>
                                        </DataTemplate>
                                    </CheckBox.ContentTemplate>
                                </CheckBox>
                                <hc:ButtonGroup
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding Name}"
                                    Visibility="{Binding SettingVisibility}">
                                    <!--  ReSharper disable once Xaml.StaticResourceNotResolved  -->
                                    <RadioButton
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource ActionIconColor}"
                                        GroupName="TaskSettings"
                                        HorizontalContentAlignment="Center"
                                        IsChecked="{Binding EnableSetting}"
                                        Margin="0"
                                        Padding="0"
                                        Style="{DynamicResource RadioGroupItemSingle}"
                                        hc:IconElement.Geometry="{StaticResource ConfigGeometry}"
                                        hc:VisualElement.HighlightBackground="Transparent"
                                        hc:VisualElement.HighlightForeground="{DynamicResource PrimaryBrush}" />
                                </hc:ButtonGroup>
                            </Grid>
                        </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                Orientation="Horizontal"
                Width="210">
                <StackPanel
                    HorizontalAlignment="Left"
                    Margin="0,10,0,10"
                    Orientation="Vertical"
                    Width="185">
                    <controls:CustomTextBlock
                        HorizontalAlignment="Center"
                        Margin="20,5,0,0"
                        ResourceKey="{Binding ViewModel.BeforeTask}"
                        TextAlignment="Center" />
                    <hc:Divider Margin="10,2,10,5" />
                    <controls:CustomTextBlock
                        HorizontalAlignment="Center"
                        Margin="20,0,0,0"
                        ResourceKey="{Binding ViewModel.AfterTask}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Width="160" />
                </StackPanel>
                <hc:ButtonGroup HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!--  ReSharper disable once Xaml.StaticResourceNotResolved  -->
                    <RadioButton
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource ActionIconColor}"
                        GroupName="TaskSettings"
                        HorizontalContentAlignment="Center"
                        IsChecked="{Binding ViewModel.ConnectSettingChecked}"
                        Padding="0"
                        Style="{DynamicResource RadioGroupItemSingle}"
                        ToolTip="{lex:Loc TaskSettings}"
                        hc:IconElement.Geometry="{StaticResource ConfigGeometry}"
                        hc:VisualElement.HighlightBackground="Transparent"
                        hc:VisualElement.HighlightForeground="{DynamicResource PrimaryBrush}"
                        x:Name="RadioButton" />
                </hc:ButtonGroup>
            </StackPanel>
            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Click="Start"
                    Content="{lex:Loc StartTask}"
                    FontWeight="Normal"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Height="46"
                    Margin="20,5,20,8"
                    VerticalContentAlignment="Center"
                    Visibility="{calcBinding:Binding '!IsRunning',
                                                     Source={x:Static helper:Instances.RootViewModel}}"
                    Width="140"
                    x:Name="startButton" />
                <Button
                    Click="Stop"
                    Content="{lex:Loc StopTask}"
                    FontWeight="Normal"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Height="46"
                    Margin="20,5,20,8"
                    VerticalContentAlignment="Center"
                    Visibility="{calcBinding:Binding 'IsRunning',
                                                     Source={x:Static helper:Instances.RootViewModel}}"
                    Width="140"
                    x:Name="stopButton" />
            </StackPanel>

        </Grid>
        <Grid Grid.Column="1" Margin="0,30,0,0">
            <ContentPresenter
                Content="{helper:ServiceProvider ServiceType={x:Type settings:TaskQueueSettingsUserControl}}"
                Visibility="{calcBinding:Binding 'ViewModel.ConnectSettingChecked'}" />
            <ContentPresenter
                Content="{helper:ServiceProvider ServiceType={x:Type settings:TaskOptionSettingsUserControl}}"
                Visibility="{calcBinding:Binding '!ViewModel.ConnectSettingChecked'}" />
        </Grid>


        <hc:ScrollViewer
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            ClipToBounds="False"
            Grid.Column="2"
            Height="{calcBinding:Binding RelativeSource={RelativeSource AncestorType=Grid},
                                         Path='ActualHeight - 20'}"
            HorizontalScrollBarVisibility="Disabled"
            IsInertiaEnabled="True"
            Margin="15,8,10,5"
            PanningMode="VerticalOnly"
            VerticalAlignment="Top"
            VerticalContentAlignment="Top"
            properties:AutoScroll.AutoScroll="True">

            <ItemsControl ItemsSource="{Binding Path=ViewModel.LogItemViewModels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:CustomTextBlock
                                FontSize="14.5"
                                Foreground="{DynamicResource GrayColor1}"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                Margin="0,5,12,0"
                                Text="{Binding Time}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Stretch" />
                            <controls:CustomTextBlock
                                FontSize="15.5"
                                FontWeight="{Binding Weight}"
                                Foreground="{Binding Color}"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                Margin="0,5"
                                Text="{Binding Content}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Stretch" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </hc:ScrollViewer>
    </Grid>
</UserControl>
