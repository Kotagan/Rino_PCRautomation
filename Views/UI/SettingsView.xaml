<UserControl
    d:DataContext="{d:DesignInstance ui:SettingsView,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="MFAWPF.Views.UI.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:calcBinding="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MFAWPF.Views.UserControl"
    xmlns:custom="clr-namespace:MFAWPF.Custom"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:MFAWPF.Configuration"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MFAWPF.Helper"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:MFAWPF.Styles.Properties"
    xmlns:settings="clr-namespace:MFAWPF.Views.UserControl.Settings"
    xmlns:ui="clr-namespace:MFAWPF.Views.UI"
    xmlns:views="clr-namespace:MFAWPF.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:anim="clr-namespace:MFAWPF.Helper.Animations">
    <Grid Margin="20,5,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox
            BorderThickness="0"
            DisplayMemberPath="Name"
            Grid.Column="0"
            ItemContainerStyle="{StaticResource MasterListBoxItemStyle}"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding ViewModel.ListTitle}"
            Margin="10"
            SelectedIndex="{Binding ViewModel.SelectedIndex, Mode=TwoWay}"
            Style="{StaticResource MasterListBoxStyle}"
            x:Name="MasterListBox" />

        <Grid Grid.Column="1">
        <hc:ScrollViewer
            HorizontalAlignment="Stretch"
            IsInertiaEnabled="False"
            Margin="20,5,20,10"
            PanningMode="VerticalOnly"
            VerticalScrollBarVisibility="Auto"
            properties:ScrollViewerBinding.DividerVerticalOffsetList="{Binding ViewModel.DividerVerticalOffsetList}"
            properties:ScrollViewerBinding.ExtentHeight="{Binding ViewModel.ScrollExtentHeight}"
            properties:ScrollViewerBinding.VerticalOffset="{Binding ViewModel.ScrollOffset}"
            properties:ScrollViewerBinding.ViewportHeight="{Binding ViewModel.ScrollViewportHeight}"
            x:Name="Viewer">
            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

                <StackPanel>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <hc:Divider Content="{Binding ViewModel.ListTitle[0].Name}" HorizontalContentAlignment="Left" Margin="0,0,0,12" />
                            <ContentPresenter Content="{helper:ServiceProvider ServiceType={x:Type settings:TimerSettingsUserControl}}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <hc:Divider Content="{Binding ViewModel.ListTitle[1].Name}" HorizontalContentAlignment="Left" Margin="0,0,0,12" />
                            <ContentPresenter Content="{helper:ServiceProvider ServiceType={x:Type settings:PerformanceUserControl}}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <hc:Divider Content="{Binding ViewModel.ListTitle[2].Name}" HorizontalContentAlignment="Left" Margin="0,0,0,12" />
                            <ContentPresenter Content="{helper:ServiceProvider ServiceType={x:Type settings:GameSettingsUserControl}}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <hc:Divider Content="{Binding ViewModel.ListTitle[3].Name}" HorizontalContentAlignment="Left" Margin="0,0,0,12" />
                            <ContentPresenter Content="{helper:ServiceProvider ServiceType={x:Type settings:ConnectSettingsUserControl}}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <hc:Divider Content="{Binding ViewModel.ListTitle[4].Name}" HorizontalContentAlignment="Left" Margin="0,0,0,12" />
                            <ContentPresenter Content="{helper:ServiceProvider ServiceType={x:Type settings:StartSettingsUserControl}}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <hc:Divider Content="{Binding ViewModel.ListTitle[5].Name}" HorizontalContentAlignment="Left" Margin="0,0,0,12" />
                            <ContentPresenter Content="{helper:ServiceProvider ServiceType={x:Type settings:GuiSettingsUserControl}}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <hc:Divider Content="{Binding ViewModel.ListTitle[6].Name}" HorizontalContentAlignment="Left" Margin="0,0,0,12" />
                            <ContentPresenter Content="{helper:ServiceProvider ServiceType={x:Type settings:ExternalNotificationSettingsUserControl}}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <hc:Divider Content="{Binding ViewModel.ListTitle[7].Name}" HorizontalContentAlignment="Left" Margin="0,0,0,12" />
                            <ContentPresenter Content="{helper:ServiceProvider ServiceType={x:Type settings:HotKeySettingsUserControl}}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <hc:Divider Content="{Binding ViewModel.ListTitle[8].Name}" HorizontalContentAlignment="Left" Margin="0,0,0,12" />
                            <ContentPresenter Content="{helper:ServiceProvider ServiceType={x:Type settings:VersionUpdateSettingsUserControl}}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </hc:ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
