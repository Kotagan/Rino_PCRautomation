<UserControl
    d:DataContext="{d:DesignInstance ui:RootView,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="MFAWPF.Views.UI.NotifyIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:converters="clr-namespace:MFAWPF.Helper.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:MFAWPF.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:MFAWPF.Views.UI"
    xmlns:viewModels="clr-namespace:MFAWPF.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Tray Context Menu Vector Geometries -->
        <Geometry x:Key="TrayPlayGeometry">M 4 2 L 14 8 L 4 14 Z</Geometry>
        <Geometry x:Key="TrayStopGeometry">M 3 3 L 13 3 L 13 13 L 3 13 Z</Geometry>
        <Geometry x:Key="TrayCheckGeometry">M 2 7 L 5.5 10.5 L 12 3</Geometry>

        <!-- Tray Context Menu Container Style -->
        <Style TargetType="ContextMenu" x:Key="TrayContextMenuStyle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border
                            Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="12"
                            Padding="6,7"
                            SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="18"
                                    Color="Black"
                                    Direction="270"
                                    Opacity="0.22"
                                    ShadowDepth="3" />
                            </Border.Effect>
                            <StackPanel
                                IsItemsHost="True"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                MinWidth="185" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tray Separator Style -->
        <Style TargetType="Separator" x:Key="TraySeparatorStyle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border
                            Background="{TemplateBinding Background}"
                            Height="{TemplateBinding Height}"
                            Margin="{TemplateBinding Padding}"
                            Opacity="{TemplateBinding Opacity}"
                            SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tray Header Card MenuItem Style -->
        <Style TargetType="MenuItem" x:Key="TrayHeaderMenuItemStyle">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border
                            x:Name="HeaderBorder"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="2,2,2,4"
                            Padding="10,8"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Logo Badge -->
                                <Border
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="6"
                                    Grid.Column="0"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Width="28">
                                    <Path
                                        Data="{StaticResource LogoGeometry}"
                                        Fill="White"
                                        Height="15"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        Width="15" />
                                </Border>

                                <!-- App Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Text="{lex:Loc AppTitle}" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Margin="0,1,0,0"
                                        Text="MaaFramework" />
                                </StackPanel>

                                <!-- Live Status Badge -->
                                <Border
                                    x:Name="StatusBadge"
                                    Background="{DynamicResource RegionBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Grid.Column="2"
                                    Margin="6,0,0,0"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse
                                            x:Name="StatusDot"
                                            Fill="#888888"
                                            Height="6"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Width="6" />
                                        <TextBlock
                                            x:Name="StatusText"
                                            FontSize="11"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Text="{lex:Loc StatusIdle}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource RegionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tray Standard MenuItem Style (with Hover slide animation, indicator bar & submenu popup) -->
        <Style TargetType="MenuItem" x:Key="TrayMenuItemStyle">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="8,5,10,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Margin="2,1"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TranslateTransform X="0" Y="0" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Active Indicator Bar -->
                                <Border
                                    x:Name="IndicatorBar"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="1.5"
                                    Grid.Column="0"
                                    Height="15"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,6,0"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5"
                                    VerticalAlignment="Center"
                                    Width="3.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.3" />
                                    </Border.RenderTransform>
                                </Border>

                                <!-- Icon Presenter -->
                                <ContentPresenter
                                    x:Name="IconHost"
                                    ContentSource="Icon"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    Margin="2,0,8,0"
                                    SnapsToDevicePixels="True"
                                    VerticalAlignment="Center" />

                                <!-- Header Text -->
                                <ContentPresenter
                                    x:Name="HeaderHost"
                                    ContentSource="Header"
                                    Grid.Column="2"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    RecognizesAccessKey="True"
                                    SnapsToDevicePixels="True"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                                <!-- Submenu Arrow -->
                                <Path
                                    x:Name="SubmenuArrow"
                                    Data="{StaticResource RightGeometry}"
                                    Fill="{DynamicResource SecondaryTextBrush}"
                                    Grid.Column="3"
                                    Height="9"
                                    HorizontalAlignment="Right"
                                    Margin="10,0,2,0"
                                    Stretch="Uniform"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Width="6" />

                                <!-- Submenu Popup -->
                                <Popup
                                    x:Name="PART_Popup"
                                    AllowsTransparency="True"
                                    Focusable="False"
                                    HorizontalOffset="4"
                                    IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                    Placement="Right"
                                    PopupAnimation="Fade"
                                    SnapsToDevicePixels="True"
                                    VerticalOffset="-6">
                                    <Border
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="12"
                                        Padding="6,7"
                                        SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="18"
                                                Color="Black"
                                                Direction="270"
                                                Opacity="0.22"
                                                ShadowDepth="3" />
                                        </Border.Effect>
                                        <StackPanel
                                            IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"
                                            MinWidth="140" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                                <Setter TargetName="IndicatorBar" Property="Opacity" Value="1.0" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Duration="0:0:0.15"
                                                Storyboard.TargetName="ItemBorder"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                To="3.5">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Duration="0:0:0.15"
                                                Storyboard.TargetName="IndicatorBar"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1.0">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Duration="0:0:0.15"
                                                Storyboard.TargetName="ItemBorder"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                To="0.0">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Duration="0:0:0.15"
                                                Storyboard.TargetName="IndicatorBar"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderHost" Property="Opacity" Value="0.45" />
                                <Setter TargetName="IconHost" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tray Exit MenuItem Style (Red Danger Accent on Hover) -->
        <Style TargetType="MenuItem" x:Key="TrayExitMenuItemStyle">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="8,5,10,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Margin="2,1"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TranslateTransform X="0" Y="0" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Red Indicator Bar -->
                                <Border
                                    x:Name="IndicatorBar"
                                    Background="#FFE53935"
                                    CornerRadius="1.5"
                                    Grid.Column="0"
                                    Height="15"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,6,0"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5"
                                    VerticalAlignment="Center"
                                    Width="3.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0.3" />
                                    </Border.RenderTransform>
                                </Border>

                                <!-- Icon Presenter -->
                                <ContentPresenter
                                    x:Name="IconHost"
                                    ContentSource="Icon"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    Margin="2,0,8,0"
                                    SnapsToDevicePixels="True"
                                    VerticalAlignment="Center" />

                                <!-- Header Text -->
                                <ContentPresenter
                                    x:Name="HeaderHost"
                                    ContentSource="Header"
                                    Grid.Column="2"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    RecognizesAccessKey="True"
                                    SnapsToDevicePixels="True"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1AE53935" />
                                <Setter TargetName="IndicatorBar" Property="Opacity" Value="1.0" />
                                <Setter Property="Foreground" Value="#FFE53935" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Duration="0:0:0.15"
                                                Storyboard.TargetName="ItemBorder"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                To="3.5">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Duration="0:0:0.15"
                                                Storyboard.TargetName="IndicatorBar"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1.0">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Duration="0:0:0.15"
                                                Storyboard.TargetName="ItemBorder"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                To="0.0">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Duration="0:0:0.15"
                                                Storyboard.TargetName="IndicatorBar"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <hc:NotifyIcon
        Name="notifyIcon"
        Text="{lex:Loc AppTitle}"
        Visibility="Visible">
        <hc:NotifyIcon.ContextMenu>
            <ContextMenu x:Name="TrayContextMenu" Style="{StaticResource TrayContextMenuStyle}">
                <!-- Header Card (Logo, Rino, Status Badge) -->
                <MenuItem x:Name="headerMenu" Style="{StaticResource TrayHeaderMenuItemStyle}" />

                <Separator Style="{StaticResource TraySeparatorStyle}" />

                <!-- Window Show/Hide Toggle -->
                <MenuItem x:Name="windowActionMenu" Style="{StaticResource TrayMenuItemStyle}">
                    <MenuItem.Icon>
                        <Path
                            x:Name="windowActionIcon"
                            Data="{StaticResource WindowRestoreGeometry}"
                            Fill="{DynamicResource PrimaryTextBrush}"
                            Height="14"
                            Stretch="Uniform"
                            Width="14" />
                    </MenuItem.Icon>
                    <MenuItem.Header>
                        <TextBlock x:Name="windowActionText" Text="{lex:Loc OpenMainWindow}" />
                    </MenuItem.Header>
                </MenuItem>

                <!-- Start Tasks -->
                <MenuItem x:Name="startMenu" Style="{StaticResource TrayMenuItemStyle}">
                    <MenuItem.Icon>
                        <Path
                            Data="{StaticResource TrayPlayGeometry}"
                            Fill="{DynamicResource PrimaryBrush}"
                            Height="13"
                            Stretch="Uniform"
                            Width="13" />
                    </MenuItem.Icon>
                    <MenuItem.Header>
                        <TextBlock Text="{lex:Loc StartTask}" />
                    </MenuItem.Header>
                </MenuItem>

                <!-- Stop Tasks -->
                <MenuItem x:Name="stopMenu" Style="{StaticResource TrayMenuItemStyle}">
                    <MenuItem.Icon>
                        <Path
                            Data="{StaticResource TrayStopGeometry}"
                            Fill="#FFE53935"
                            Height="12"
                            Stretch="Uniform"
                            Width="12" />
                    </MenuItem.Icon>
                    <MenuItem.Header>
                        <TextBlock Text="{lex:Loc StopTask}" />
                    </MenuItem.Header>
                </MenuItem>

                <!-- Quick Navigation: Tasks Sequence -->
                <MenuItem x:Name="tasksMenu" Style="{StaticResource TrayMenuItemStyle}">
                    <MenuItem.Icon>
                        <Path
                            Data="{StaticResource DocumentGeometry}"
                            Fill="{DynamicResource PrimaryTextBrush}"
                            Height="14"
                            Stretch="Uniform"
                            Width="14" />
                    </MenuItem.Icon>
                    <MenuItem.Header>
                        <TextBlock Text="{lex:Loc Tasks}" />
                    </MenuItem.Header>
                </MenuItem>

                <!-- Quick Navigation: Settings -->
                <MenuItem x:Name="settingsMenu" Style="{StaticResource TrayMenuItemStyle}">
                    <MenuItem.Icon>
                        <Path
                            Data="{StaticResource ConfigGeometry}"
                            Fill="{DynamicResource PrimaryTextBrush}"
                            Height="14"
                            Stretch="Uniform"
                            Width="14" />
                    </MenuItem.Icon>
                    <MenuItem.Header>
                        <TextBlock Text="{lex:Loc Settings}" />
                    </MenuItem.Header>
                </MenuItem>

                <Separator Style="{StaticResource TraySeparatorStyle}" />

                <!-- Language Selection Submenu -->
                <MenuItem x:Name="switchLangMenu" Style="{StaticResource TrayMenuItemStyle}">
                    <MenuItem.Icon>
                        <Path
                            Data="{StaticResource WebsiteGeometry}"
                            Fill="{DynamicResource PrimaryTextBrush}"
                            Height="14"
                            Stretch="Uniform"
                            Width="14" />
                    </MenuItem.Icon>
                    <MenuItem.Header>
                        <TextBlock Text="{lex:Loc SwitchLanguage}" />
                    </MenuItem.Header>
                </MenuItem>

                <Separator Style="{StaticResource TraySeparatorStyle}" />

                <!-- Exit Application -->
                <MenuItem x:Name="exitMenu" Style="{StaticResource TrayExitMenuItemStyle}">
                    <MenuItem.Icon>
                        <Path
                            x:Name="exitIcon"
                            Data="{StaticResource CloseGeometry}"
                            Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                            Height="11"
                            Stretch="Uniform"
                            Width="11" />
                    </MenuItem.Icon>
                    <MenuItem.Header>
                        <TextBlock Text="{lex:Loc Quit}" />
                    </MenuItem.Header>
                </MenuItem>
            </ContextMenu>
        </hc:NotifyIcon.ContextMenu>
    </hc:NotifyIcon>
</UserControl>