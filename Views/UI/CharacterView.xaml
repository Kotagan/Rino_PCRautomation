<UserControl
    d:DesignHeight="720"
    d:DesignWidth="1100"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d"
    x:Class="MFAWPF.Views.UI.CharacterView"
    x:ClassModifier="internal"
    x:Name="CharacterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style BasedOn="{StaticResource DialogSecondaryButtonStyle}" TargetType="Button" x:Key="CharacterActionButtonStyle">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style BasedOn="{StaticResource DialogPrimaryButtonStyle}" TargetType="Button" x:Key="CharacterPrimaryButtonStyle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="18,0" />
        </Style>
        <Style TargetType="TextBlock" x:Key="CharacterFieldLabelStyle">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style TargetType="Border" x:Key="CharacterItemCardStyle">
            <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <DataTemplate x:Key="AnimationSlotCardTemplate">
            <Border Margin="4" Style="{StaticResource CharacterItemCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="14" FontWeight="Medium"
                                   Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,5,0"
                                       Text="{lex:Loc CharacterPlaybackRateShort}"
                                       VerticalAlignment="Center" />
                            <TextBox Height="28"
                                     Text="{Binding PlaybackRate, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                                     TextAlignment="Center"
                                     ToolTip="{lex:Loc CharacterPlaybackRate}"
                                     Width="52" />
                        </StackPanel>
                    </Grid>
                    <Button Command="{Binding DataContext.PreviewAnimationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Cursor="Hand"
                            Grid.Row="1"
                            Height="72"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"
                            ToolTip="{lex:Loc CharacterAnimationPreview}"
                            Width="72">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Height="72"
                                        Width="72">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <TextBlock FontSize="24"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Text="🐾"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Image RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{Binding Thumbnail}"
                                   Stretch="Uniform" />
                        </Grid>
                    </Button>
                    <TextBox Grid.Row="2"
                             Margin="0,8,0,0"
                             MinHeight="34"
                             Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding SourcePath}" />
                    <UniformGrid Columns="2" Grid.Row="3" Margin="0,8,0,0" Rows="2">
                        <Button Command="{Binding DataContext.BrowseAnimationFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="{lex:Loc CharacterChooseFile}"
                                Margin="0,0,4,4"
                                Style="{StaticResource CharacterActionButtonStyle}" />
                        <Button Command="{Binding DataContext.BrowseAnimationFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="{lex:Loc CharacterChooseFrameFolder}"
                                Margin="4,0,0,4"
                                Style="{StaticResource CharacterActionButtonStyle}" />
                        <Button Command="{Binding DataContext.PreviewAnimationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="{lex:Loc CharacterAnimationPreview}"
                                Margin="0,0,4,0"
                                Style="{StaticResource CharacterActionButtonStyle}" />
                        <Button Command="{Binding DataContext.ClearAnimationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="{lex:Loc CharacterClearAnimation}"
                                Margin="4,0,0,0"
                                Style="{StaticResource CharacterActionButtonStyle}" />
                    </UniformGrid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20,5,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox
                BorderThickness="0"
                ItemContainerStyle="{StaticResource MasterListBoxItemStyle}"
                Margin="10"
                SelectedIndex="0"
                SelectionChanged="OnSectionSelectionChanged"
                Style="{StaticResource MasterListBoxStyle}"
                x:Name="SectionList">
                <ListBoxItem Content="{lex:Loc CharacterProfile}" />
                <ListBoxItem Content="{lex:Loc CharacterPreview}" />
                <ListBoxItem Content="{lex:Loc CharacterFreeMovement}" />
                <ListBoxItem Content="{lex:Loc CharacterAnimations}" />
                <ListBoxItem Content="{lex:Loc CharacterTaskRules}" />
            </ListBox>
            <Border
                Background="{DynamicResource ControlSurfaceBrush}"
                CornerRadius="8"
                Grid.Row="1"
                Height="170"
                Margin="10,0,10,10"
                Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Margin="2,0,2,6"
                        Text="{Binding SelectedPreviewSlot.Title}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding SelectedPreviewSlot.Title}" />
                    <Grid Grid.Row="1">
                        <TextBlock
                            FontSize="34"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            HorizontalAlignment="Center"
                            IsHitTestVisible="False"
                            Text="🐾"
                            VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewFrame}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="{Binding PreviewFrame}"
                            Stretch="Uniform" />
                    </Grid>
                </Grid>
            </Border>
            <Button
                Command="{Binding SaveConfigurationCommand}"
                Content="{lex:Loc CharacterSaveConfiguration}"
                Grid.Row="2"
                hc:IconElement.Geometry="{StaticResource SaveGeometry}"
                Margin="10,0,10,10"
                Style="{StaticResource CharacterPrimaryButtonStyle}" />
        </Grid>

        <hc:ScrollViewer
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            IsInertiaEnabled="False"
            Margin="20,5,20,10"
            PanningMode="VerticalOnly"
            ScrollChanged="OnSettingsViewerScrollChanged"
            VerticalScrollBarVisibility="Auto"
            x:Name="SettingsViewer">
            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <StackPanel x:Name="SettingsSectionsPanel">
                    <Border Style="{StaticResource SettingsCardStyle}" x:Name="ProfileSection">
                        <StackPanel>
                            <hc:Divider Content="{lex:Loc CharacterProfile}"
                                        HorizontalContentAlignment="Left" Margin="0,0,0,12" />
                            <StackPanel HorizontalAlignment="Stretch" MaxWidth="520">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{lex:Loc CharacterEnabled}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" HorizontalAlignment="Right"
                                              IsChecked="{Binding IsEnabled}" />
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{lex:Loc CharacterCurrentProfile}" VerticalAlignment="Center" />
                                    <hc:ComboBox DisplayMemberPath="Name" Grid.Column="1"
                                                 ItemsSource="{Binding Profiles}" MinHeight="34"
                                                 SelectedItem="{Binding SelectedProfile}" Width="260" />
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{lex:Loc CharacterProfileName}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" KeyDown="OnProfileNameTextBoxKeyDown" MinHeight="34"
                                             Text="{Binding CurrentProfileName, UpdateSourceTrigger=LostFocus}"
                                             Width="260" />
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{lex:Loc CharacterProfileActions}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" Width="260">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{Binding AddProfileCommand}"
                                                Content="{lex:Loc CharacterCreateProfile}"
                                                Style="{StaticResource CharacterActionButtonStyle}" />
                                        <Button Command="{Binding DeleteProfileCommand}"
                                                Content="{lex:Loc CharacterDeleteProfile}"
                                                Grid.Column="2"
                                                Style="{StaticResource CharacterActionButtonStyle}" />
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{lex:Loc CharacterAssetLocation}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Width="260">
                                        <Border Background="{DynamicResource ControlSurfaceBrush}"
                                                CornerRadius="6" Padding="10,7">
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Text="{Binding AssetRoot}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding AssetRoot}" />
                                        </Border>
                                        <Button Command="{Binding OpenAssetRootCommand}"
                                                Content="{lex:Loc CharacterOpenFolder}"
                                                Margin="0,8,0,0"
                                                Style="{StaticResource CharacterActionButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}" x:Name="PreviewSection">
                        <StackPanel>
                            <hc:Divider Content="{lex:Loc CharacterPreview}"
                                        HorizontalContentAlignment="Left" Margin="0,0,0,12" />
                            <StackPanel HorizontalAlignment="Stretch" MaxWidth="520">
                                <Border Background="{DynamicResource ControlSurfaceBrush}"
                                        CornerRadius="8" Height="260" HorizontalAlignment="Center"
                                        MouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
                                        Width="240" x:Name="PreviewSurface">
                                    <Grid>
                                        <TextBlock FontSize="42"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Text="🐾"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PreviewFrame}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding PreviewFrame}" Stretch="Uniform" />
                                        <Canvas IsHitTestVisible="False">
                                            <Line Stroke="{DynamicResource DangerBrush}" StrokeThickness="1"
                                                  X1="0" X2="240" Y1="240" Y2="240" />
                                            <Ellipse Canvas.Left="115" Canvas.Top="235"
                                                     Fill="{DynamicResource DangerBrush}"
                                                     Height="10" Width="10"
                                                     x:Name="FootAnchorMarker" />
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,10,0,10"
                                           Text="{lex:Loc CharacterFootAnchorHint}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{lex:Loc CharacterSize}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" Width="260">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Maximum="512" Minimum="64" TickFrequency="16"
                                                Value="{Binding SelectedProfile.Size}"
                                                x:Name="CharacterSizeSlider" />
                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Grid.Column="1" HorizontalAlignment="Right"
                                                   Text="{Binding ElementName=CharacterSizeSlider, Path=Value, StringFormat={}{0:F0}px}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{lex:Loc CharacterShowStatus}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" HorizontalAlignment="Right"
                                              IsChecked="{Binding SelectedProfile.ShowStatusBar}" />
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{lex:Loc CharacterLockPosition}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" HorizontalAlignment="Right"
                                              IsChecked="{Binding SelectedProfile.IsPositionLocked}" />
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{lex:Loc CharacterScreenPosition}" VerticalAlignment="Center" />
                                    <Button Command="{Binding ResetPositionCommand}"
                                            Content="{lex:Loc CharacterResetPosition}"
                                            Grid.Column="1" Style="{StaticResource CharacterActionButtonStyle}"
                                            Width="260" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}" x:Name="MovementSection">
                        <StackPanel>
                            <hc:Divider Content="{lex:Loc CharacterFreeMovement}"
                                        HorizontalContentAlignment="Left" Margin="0,0,0,12" />
                            <StackPanel HorizontalAlignment="Stretch" MaxWidth="520">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{lex:Loc CharacterFreeMovementEnabled}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" HorizontalAlignment="Right"
                                              IsChecked="{Binding SelectedProfile.IsFreeMovementEnabled}" />
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{lex:Loc CharacterMovementSpeed}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" Width="260">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="62" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Maximum="300" Minimum="10" TickFrequency="10"
                                                Value="{Binding SelectedProfile.MovementSpeed}"
                                                x:Name="CharacterMovementSpeedSlider" />
                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Grid.Column="1" HorizontalAlignment="Right"
                                                   Text="{Binding ElementName=CharacterMovementSpeedSlider, Path=Value, StringFormat={}{0:F0}px/s}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{lex:Loc CharacterAutomaticMirror}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" HorizontalAlignment="Right"
                                              IsChecked="{Binding SelectedProfile.UseAutomaticMirror}" />
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{lex:Loc CharacterMinimumIdle}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" Width="260">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Maximum="30" Minimum="1"
                                                Value="{Binding SelectedProfile.MinimumIdleSeconds}"
                                                x:Name="MinimumIdleSlider" />
                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Grid.Column="1" HorizontalAlignment="Right"
                                                   Text="{Binding ElementName=MinimumIdleSlider, Path=Value, StringFormat={}{0:F0}s}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{lex:Loc CharacterMaximumIdle}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" Width="260">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Maximum="60" Minimum="1"
                                                Value="{Binding SelectedProfile.MaximumIdleSeconds}"
                                                x:Name="MaximumIdleSlider" />
                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Grid.Column="1" HorizontalAlignment="Right"
                                                   Text="{Binding ElementName=MaximumIdleSlider, Path=Value, StringFormat={}{0:F0}s}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{lex:Loc CharacterFootAnchorX}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" Width="260">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Maximum="1" Minimum="0"
                                                Value="{Binding SelectedProfile.FootAnchorX}"
                                                x:Name="FootAnchorXSlider" />
                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Grid.Column="1" HorizontalAlignment="Right"
                                                   Text="{Binding ElementName=FootAnchorXSlider, Path=Value, StringFormat={}{0:P0}}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{lex:Loc CharacterFootAnchorY}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" Width="260">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Maximum="1" Minimum="0"
                                                Value="{Binding SelectedProfile.FootAnchorY}"
                                                x:Name="FootAnchorYSlider" />
                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Grid.Column="1" HorizontalAlignment="Right"
                                                   Text="{Binding ElementName=FootAnchorYSlider, Path=Value, StringFormat={}{0:P0}}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}" x:Name="AnimationSection">
                        <StackPanel>
                            <hc:Divider Content="{lex:Loc CharacterAnimations}"
                                        HorizontalContentAlignment="Left" Margin="0,0,0,12" />
                            <TextBlock FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,14"
                                       Text="{lex:Loc CharacterAnimationsDescription}"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding AnimationRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Slot 1 -->
                                            <ContentControl Grid.Row="0" Grid.Column="0"
                                                            Content="{Binding Slot1}"
                                                            ContentTemplate="{StaticResource AnimationSlotCardTemplate}"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch" />

                                            <!-- Column 1: Vertical Divider between Slot 1 and Slot 2 -->
                                            <Border Grid.Row="0" Grid.Column="1"
                                                    Background="{DynamicResource BorderBrush}"
                                                    Height="72"
                                                    HorizontalAlignment="Center"
                                                    Margin="6,0"
                                                    VerticalAlignment="Center"
                                                    Width="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Slot2}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Slot 2 -->
                                            <ContentControl Grid.Row="0" Grid.Column="2"
                                                            Content="{Binding Slot2}"
                                                            ContentTemplate="{StaticResource AnimationSlotCardTemplate}"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Slot2}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <!-- Column 3: Vertical Divider between Slot 2 and Slot 3 -->
                                            <Border Grid.Row="0" Grid.Column="3"
                                                    Background="{DynamicResource BorderBrush}"
                                                    Height="72"
                                                    HorizontalAlignment="Center"
                                                    Margin="6,0"
                                                    VerticalAlignment="Center"
                                                    Width="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Slot3}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Slot 3 -->
                                            <ContentControl Grid.Row="0" Grid.Column="4"
                                                            Content="{Binding Slot3}"
                                                            ContentTemplate="{StaticResource AnimationSlotCardTemplate}"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Slot3}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <!-- Row 1: Short horizontal divider centered under Slot 1 -->
                                            <Border Grid.Row="1" Grid.Column="0"
                                                    Background="{DynamicResource BorderBrush}"
                                                    Height="1"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,10"
                                                    VerticalAlignment="Center"
                                                    Width="72">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLastRow}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Row 1: Short horizontal divider centered under Slot 2 -->
                                            <Border Grid.Row="1" Grid.Column="2"
                                                    Background="{DynamicResource BorderBrush}"
                                                    Height="1"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,10"
                                                    VerticalAlignment="Center"
                                                    Width="72">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLastRow}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Slot2}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Row 1: Short horizontal divider centered under Slot 3 -->
                                            <Border Grid.Row="1" Grid.Column="4"
                                                    Background="{DynamicResource BorderBrush}"
                                                    Height="1"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,10"
                                                    VerticalAlignment="Center"
                                                    Width="72">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLastRow}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Slot3}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}" x:Name="TaskRulesSection">
                        <StackPanel>
                            <hc:Divider Content="{lex:Loc CharacterTaskRules}"
                                        HorizontalContentAlignment="Left" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{lex:Loc CharacterTaskRulesDescription}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <Button Command="{Binding RefreshTaskListCommand}"
                                        Content="{lex:Loc CharacterRefreshTaskList}"
                                        Grid.Column="1" Margin="12,0,0,0"
                                        Style="{StaticResource CharacterActionButtonStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <hc:ComboBox DisplayMemberPath="Name"
                                             ItemsSource="{Binding AvailableTasks}"
                                             MinHeight="36"
                                             SelectedItem="{Binding SelectedTask}" />
                                <Button Command="{Binding AddTaskRuleCommand}"
                                        Content="{lex:Loc CharacterAddTaskRule}"
                                        Grid.Column="1" Margin="8,0,0,0"
                                        Style="{StaticResource CharacterActionButtonStyle}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding TaskRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CharacterItemCardStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="14" FontWeight="SemiBold"
                                                           Text="{Binding TaskName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding TaskName}"
                                                           VerticalAlignment="Center" />
                                                <Button Command="{Binding DataContext.RemoveTaskRuleCommand, ElementName=CharacterPage}"
                                                        CommandParameter="{Binding}"
                                                        Content="{lex:Loc CharacterDeleteTaskRule}"
                                                        Grid.Column="1"
                                                        Style="{StaticResource CharacterActionButtonStyle}" />

                                                <Grid Grid.ColumnSpan="2" Grid.Row="1" Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="82" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource CharacterFieldLabelStyle}"
                                                                   Text="{lex:Loc CharacterStatusText}" />
                                                        <TextBox MaxLength="24" MinHeight="34"
                                                                 Text="{Binding StatusText, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Style="{StaticResource CharacterFieldLabelStyle}"
                                                                   Text="{lex:Loc CharacterPlaybackRateShort}" />
                                                        <TextBox MinHeight="34"
                                                                 Text="{Binding Animation.PlaybackRate, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"
                                                                 TextAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.ColumnSpan="2" Grid.Row="2" Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox MinHeight="34"
                                                             Text="{Binding Animation.SourcePath, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="{Binding Animation.SourcePath}" />
                                                    <Button Command="{Binding DataContext.BrowseTaskAnimationCommand, ElementName=CharacterPage}"
                                                            CommandParameter="{Binding}"
                                                            Content="{lex:Loc CharacterChooseAnimation}"
                                                            Grid.Column="1" Margin="8,0,0,0"
                                                            Style="{StaticResource CharacterActionButtonStyle}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </hc:ScrollViewer>
    </Grid>
</UserControl>
