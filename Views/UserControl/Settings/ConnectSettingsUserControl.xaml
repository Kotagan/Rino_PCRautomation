<UserControl
    d:DataContext="{d:DesignInstance local:ConnectSettingsUserControl,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="550"
    mc:Ignorable="d"
    x:Class="MFAWPF.Views.UserControl.Settings.ConnectSettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:calcBinding="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MFAWPF.Helper"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:MFAWPF.Views.UserControl.Settings"
    xmlns:maa="clr-namespace:MFAWPF.Extensions.Maa"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:MFAWPF.Views.UI"
    xmlns:views="clr-namespace:MFAWPF.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:extensions="clr-namespace:MFAWPF.Extensions">
    <StackPanel HorizontalAlignment="Center" Width="440" Margin="0,4">
        <!-- ADB Control Options -->
        <Grid Margin="0,6" Visibility="{calcBinding:Binding 'CurrentController == maa:MaaControllerTypes.Adb', Source={x:Static helper:Instances.ConnectingViewModel}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{lex:Loc CaptureModeOption}" />
            <hc:ComboBox
                Grid.Column="1"
                HorizontalAlignment="Right" extensions:ComboBoxExtensions.DisableNavigationOnLostFocus="True"
                IsEnabled="{calcBinding:Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                ItemsSource="{Binding ViewModel.AdbControlScreenCapTypes}"
                SelectedValue="{Binding ViewModel.AdbControlScreenCapType}"
                Width="260" />
        </Grid>

        <Grid Margin="0,6" Visibility="{calcBinding:Binding 'CurrentController == maa:MaaControllerTypes.Adb', Source={x:Static helper:Instances.ConnectingViewModel}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{lex:Loc InputModeOption}" />
            <hc:ComboBox
                DisplayMemberPath="Name" extensions:ComboBoxExtensions.DisableNavigationOnLostFocus="True"
                Grid.Column="1"
                HorizontalAlignment="Right"
                IsEnabled="{calcBinding:Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                ItemsSource="{Binding ViewModel.AdbControlInputTypes}"
                SelectedValue="{Binding ViewModel.AdbControlInputType}"
                SelectedValuePath="Other"
                Width="260" />
        </Grid>

        <Grid Margin="0,6" Visibility="{calcBinding:Binding 'CurrentController == maa:MaaControllerTypes.Adb', Source={x:Static helper:Instances.ConnectingViewModel}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{lex:Loc RememberAdb}" />
            <CheckBox
                Grid.Column="1"
                HorizontalAlignment="Right"
                IsChecked="{Binding ViewModel.RememberAdb}"
                IsEnabled="{calcBinding:Binding Idle, Source={x:Static helper:Instances.RootViewModel}}" />
        </Grid>

        <!-- Win32 Control Options -->
        <Grid Margin="0,6" Visibility="{calcBinding:Binding 'CurrentController == maa:MaaControllerTypes.Win32', Source={x:Static helper:Instances.ConnectingViewModel}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{lex:Loc CaptureModeOption}" />
            <hc:ComboBox extensions:ComboBoxExtensions.DisableNavigationOnLostFocus="True"
                         Grid.Column="1"
                         HorizontalAlignment="Right"
                         IsEnabled="{calcBinding:Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                         ItemsSource="{Binding ViewModel.Win32ControlScreenCapTypes}"
                         SelectedValue="{Binding ViewModel.Win32ControlScreenCapType}"
                         Width="260" />
        </Grid>

        <Grid Margin="0,6" Visibility="{calcBinding:Binding 'CurrentController == maa:MaaControllerTypes.Win32', Source={x:Static helper:Instances.ConnectingViewModel}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{lex:Loc InputModeOption}" />
            <hc:ComboBox
                DisplayMemberPath="Name" extensions:ComboBoxExtensions.DisableNavigationOnLostFocus="True"
                Grid.Column="1"
                HorizontalAlignment="Right"
                IsEnabled="{calcBinding:Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                ItemsSource="{Binding ViewModel.Win32ControlInputTypes}"
                SelectedValue="{Binding ViewModel.Win32ControlInputType}"
                Width="260" />
        </Grid>

        <Grid Margin="0,6" Visibility="{calcBinding:Binding 'CurrentController == maa:MaaControllerTypes.Adb', Source={x:Static helper:Instances.ConnectingViewModel}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{lex:Loc RetryOnDisconnected}" />
            <CheckBox
                Grid.Column="1"
                HorizontalAlignment="Right"
                IsChecked="{Binding ViewModel.RetryOnDisconnected}" />
        </Grid>

        <Grid Margin="0,6" Visibility="{calcBinding:Binding 'CurrentController == maa:MaaControllerTypes.Adb', Source={x:Static helper:Instances.ConnectingViewModel}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{lex:Loc AllowAdbRestart}" />
            <CheckBox
                Grid.Column="1"
                HorizontalAlignment="Right"
                IsChecked="{Binding ViewModel.AllowAdbRestart}" />
        </Grid>

        <Grid Margin="0,6" Visibility="{calcBinding:Binding 'CurrentController == maa:MaaControllerTypes.Adb', Source={x:Static helper:Instances.ConnectingViewModel}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{lex:Loc AllowAdbHardRestart}" />
            <CheckBox
                Grid.Column="1"
                HorizontalAlignment="Right"
                IsChecked="{Binding ViewModel.AllowAdbHardRestart}" />
        </Grid>
    </StackPanel>
</UserControl>
