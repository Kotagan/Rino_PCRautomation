<UserControl
    d:DataContext="{d:DesignInstance settings:PerformanceUserControl,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="550"
    mc:Ignorable="d"
    x:Class="MFAWPF.Views.UserControl.Settings.PerformanceUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:calcBinding="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MFAWPF.Helper"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:MFAWPF.Views.UserControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="clr-namespace:MFAWPF.Views.UserControl.Settings"
    xmlns:ui="clr-namespace:MFAWPF.Views.UI"
    xmlns:views="clr-namespace:MFAWPF.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:extensions="clr-namespace:MFAWPF.Extensions">
    <StackPanel HorizontalAlignment="Center" Width="440" Margin="0,4">
        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:CustomTextBlock
                Grid.Column="0"
                Text="{lex:Loc UseGpuForInference}"
                VerticalAlignment="Center" />
            <hc:ComboBox
                DisplayMemberPath="Name"
                Grid.Column="1"
                HorizontalAlignment="Right" extensions:ComboBoxExtensions.DisableNavigationOnLostFocus="True"
                IsEnabled="{calcBinding:Binding Idle,
                                                Source={x:Static helper:Instances.RootViewModel}}"
                ItemsSource="{Binding ViewModel.GpuOptions}"
                Margin="0,4"
                SelectedValue="{Binding ViewModel.GpuOption}"
                SelectedValuePath="Other"
                VerticalAlignment="Center"
                Width="260" />
        </Grid>

        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{lex:Loc AnimationLevelOption}" />
            <hc:ComboBox
                DisplayMemberPath="Name"
                extensions:ComboBoxExtensions.DisableNavigationOnLostFocus="True"
                Grid.Column="1"
                HorizontalAlignment="Right"
                ItemsSource="{Binding ViewModel.AnimationLevels}"
                IsEnabled="{calcBinding:Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                SelectedIndex="{Binding ViewModel.AnimationLevelIndex, Mode=TwoWay}"
                VerticalAlignment="Center"
                Width="260" />
        </Grid>
    </StackPanel>
</UserControl>
