<UserControl
    d:DataContext="{d:DesignInstance local:SoftwareNotificationSettingsUserControl,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="550"
    mc:Ignorable="d"
    x:Class="MFAWPF.Views.UserControl.Settings.SoftwareNotificationSettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MFAWPF.Helper"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:MFAWPF.Views.UserControl.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:MFAWPF.Views.UI"
    xmlns:views="clr-namespace:MFAWPF.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" Width="440" Margin="0,4">
        <!-- Windows Toast Notification Toggle -->
        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock
                    FontSize="13.5"
                    FontWeight="Medium"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="{lex:Loc EnableWindowsToastNotification}" />
                <TextBlock
                    FontSize="11.5"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Margin="0,2,0,0"
                    Text="{lex:Loc EnableWindowsToastNotificationDesc}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox
                Grid.Column="1"
                HorizontalAlignment="Right"
                IsChecked="{Binding ViewModel.EnableWindowsToastNotification}"
                IsEnabled="{c:Binding Idle, Source={x:Static helper:Instances.RootViewModel}}" />
        </Grid>

        <!-- Notification Sound Toggle -->
        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                FontSize="13.5"
                FontWeight="Medium"
                Foreground="{DynamicResource PrimaryTextBrush}"
                Text="{lex:Loc EnableNotificationSound}"
                VerticalAlignment="Center" />
            <CheckBox
                Grid.Column="1"
                HorizontalAlignment="Right"
                IsChecked="{Binding ViewModel.EnableNotificationSound}"
                IsEnabled="{c:Binding 'Idle and ViewModel.EnableWindowsToastNotification', Source={x:Static helper:Instances.RootViewModel}}" />
        </Grid>

        <!-- Taskbar Flash Toggle -->
        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                FontSize="13.5"
                FontWeight="Medium"
                Foreground="{DynamicResource PrimaryTextBrush}"
                Text="{lex:Loc EnableNotificationFlashWindow}"
                VerticalAlignment="Center" />
            <CheckBox
                Grid.Column="1"
                HorizontalAlignment="Right"
                IsChecked="{Binding ViewModel.EnableNotificationFlashWindow}"
                IsEnabled="{c:Binding 'Idle and ViewModel.EnableWindowsToastNotification', Source={x:Static helper:Instances.RootViewModel}}" />
        </Grid>

        <!-- Test Notification Button -->
        <Grid Margin="0,10,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Command="{Binding ViewModel.SendTestNotificationCommand}"
                Content="{lex:Loc SendNotificationTest}"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Height="32"
                Padding="16,0" />
        </Grid>
    </StackPanel>
</UserControl>
