                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Margin="2,0"
                                Text=":"
                                VerticalAlignment="Center" />
                            <hc:NumericUpDown
                                InputMethod.IsInputMethodEnabled="False"
                                IsEnabled="{c:Binding ViewModel.TimerModels.Timers[6].IsOn}"
                                Margin="2,0"
                                Maximum="59"
                                Minimum="0"
                                Value="{Binding ViewModel.TimerModels.Timers[6].Min}"
                                ValueFormat="00"
                                Width="54"
                                d:Value="40" />
                        </StackPanel>
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Margin="0,8,0,2"
                        Visibility="{c:Binding ViewModel.CustomConfig}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:CustomTextBlock
                            FontSize="12"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Margin="0,0,8,0"
                            Text="{lex:Loc ConfigurationName}"
                            VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                            ItemsSource="{Binding ConfigurationList, Source={x:Static helper:Instances.SettingsViewModel}}"
                            SelectedValue="{Binding ViewModel.TimerModels.Timers[6].TimerConfig, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            SelectedValuePath="Name"
                            ToolTip="{Binding ViewModel.TimerModels.Timers[6].TimerConfig}"
                            VerticalAlignment="Center"
                            extensions:ComboBoxExtensions.DisableNavigationOnLostFocus="True"
                            Focusable="False" />
                    </Grid>
                </Grid>
            </Border>

            <!--  Timer 8 (Index 7)  -->
            <Border
                Background="{DynamicResource ControlSurfaceBrush}"
                BorderBrush="{DynamicResource ControlStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Grid.Column="1"
                Grid.Row="3"
                Margin="5,4"
                Padding="12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            Content="{Binding ViewModel.TimerModels.Timers[7].TimerName}"
                            FontWeight="Medium"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding ViewModel.TimerModels.Timers[7].IsOn}"
                            VerticalAlignment="Center" />
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <hc:ComboBox
                                DisplayMemberPath="Name"
                                extensions:ComboBoxExtensions.DisableNavigationOnLostFocus="True"
                                Focusable="False"
                                IsEnabled="{c:Binding ViewModel.TimerModels.Timers[7].IsOn}"
                                ItemsSource="{Binding ViewModel.Periods}"
                                Margin="2,0"
                                SelectedIndex="{Binding ViewModel.TimerModels.Timers[7].PeriodIndex, Mode=TwoWay}"
                                Width="72" />
                            <hc:NumericUpDown
                                InputMethod.IsInputMethodEnabled="False"
                                IsEnabled="{c:Binding ViewModel.TimerModels.Timers[7].IsOn}"
                                Margin="2,0"
                                Maximum="12"
                                Minimum="0"
                                Value="{Binding ViewModel.TimerModels.Timers[7].Hour12}"
                                ValueFormat="00"
                                Width="54"
                                d:Value="9" />
                            <controls:CustomTextBlock
                                FontWeight="Bold"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Margin="2,0"
                                Text=":"
                                VerticalAlignment="Center" />
                            <hc:NumericUpDown
                                InputMethod.IsInputMethodEnabled="False"
                                IsEnabled="{c:Binding ViewModel.TimerModels.Timers[7].IsOn}"
                                Margin="2,0"
                                Maximum="59"
                                Minimum="0"
                                Value="{Binding ViewModel.TimerModels.Timers[7].Min}"
                                ValueFormat="00"
                                Width="54"
                                d:Value="50" />
                        </StackPanel>
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Margin="0,8,0,2"
                        Visibility="{c:Binding ViewModel.CustomConfig}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:CustomTextBlock
                            FontSize="12"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Margin="0,0,8,0"
                            Text="{lex:Loc ConfigurationName}"
                            VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                            ItemsSource="{Binding ConfigurationList, Source={x:Static helper:Instances.SettingsViewModel}}"
                            SelectedValue="{Binding ViewModel.TimerModels.Timers[7].TimerConfig, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            SelectedValuePath="Name"
                            ToolTip="{Binding ViewModel.TimerModels.Timers[7].TimerConfig}"
                            VerticalAlignment="Center"
                            extensions:ComboBoxExtensions.DisableNavigationOnLostFocus="True"
                            Focusable="False" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
