{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rino:schema:catalog:v1",
  "title": "RinoPackageCatalogV1",
  "description": "Signed catalog of reviewed Rino packages available to the packaged client.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "expiresAt",
    "publisherKeys",
    "packages",
    "signing"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "publisherKeys": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/publisherKey"
      }
    },
    "packages": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/packageRecord"
      }
    },
    "signing": {
      "$ref": "#/$defs/catalogSigning"
    }
  },
  "$defs": {
    "packageId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{1,126}[a-z0-9])$"
    },
    "semanticVersion": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "translations": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "publisherKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisherId",
        "publisherName",
        "keyId",
        "algorithm",
        "publicKeyBase64"
      ],
      "properties": {
        "publisherId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "publisherName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "algorithm": {
          "const": "ed25519"
        },
        "publicKeyBase64": {
          "type": "string",
          "minLength": 44,
          "maxLength": 44,
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        }
      }
    },
    "packageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "version",
        "packageType",
        "displayName",
        "summary",
        "publisherKeyId",
        "owner",
        "repository",
        "releaseTag",
        "releaseAssetId",
        "assetName",
        "byteLength",
        "sha256",
        "releasedAt",
        "compatibility"
      ],
      "properties": {
        "packageId": {
          "$ref": "#/$defs/packageId"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "packageType": {
          "enum": [
            "project",
            "feature",
            "hybrid"
          ]
        },
        "displayName": {
          "$ref": "#/$defs/localizedText"
        },
        "summary": {
          "$ref": "#/$defs/localizedText"
        },
        "gameName": {
          "$ref": "#/$defs/localizedText"
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "releaseNotes": {
          "$ref": "#/$defs/localizedText"
        },
        "publisherKeyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "owner": {
          "$ref": "#/$defs/githubName"
        },
        "repository": {
          "$ref": "#/$defs/githubName"
        },
        "releaseTag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "releaseAssetId": {
          "type": "integer",
          "minimum": 1
        },
        "assetName": {
          "type": "string",
          "minLength": 14,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.rino-package$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "releasedAt": {
          "type": "string",
          "format": "date-time"
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        }
      }
    },
    "githubName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumClientVersion",
        "sidecarProtocolVersion",
        "projectSchemaVersions",
        "operatingSystem",
        "architectures"
      ],
      "properties": {
        "minimumClientVersion": {
          "$ref": "#/$defs/semanticVersion"
        },
        "maximumClientVersion": {
          "$ref": "#/$defs/semanticVersion"
        },
        "sidecarProtocolVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "projectSchemaVersions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "operatingSystem": {
          "const": "windows"
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "x86_64"
          }
        }
      }
    },
    "catalogSigning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "signatureFile"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "signatureFile": {
          "const": "catalog-v1.sig"
        }
      }
    }
  }
}
